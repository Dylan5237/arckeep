{
  "name": "arckeep",
  "productName": "Arckeep",
  "version": "0.1.0",
  "description": "Arckeep: Dylan 的 AI 原生个人工作台（Windows 桌面应用）",
  "author": "Dylan5237",
  "license": "MIT",
  "main": "out/main/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:ts": "tsc -p tsconfig.main.json",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --format=cjs --outfile=out/preload/index.cjs --external:electron",
    "build:renderer": "vite build",
    "build:app": "npm run build:ts && npm run build:preload && npm run build:renderer",
    "start": "electron .",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "waiting": "npm run build:ts && node out/waiting/cli.js",
    "overview": "npm run build:ts && node out/overview/cli.js",
    "build": "npm run build:app && electron-builder --win --dir --publish never",
    "dist": "npm run build:app && electron-builder --win --publish never",
    "pack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@eslint/js": "^9.36.0",
    "electron": "43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.25.10",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.5",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.dylan5237.arckeep",
    "productName": "Arckeep",
    "executableName": "Arckeep",
    "npmRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arckeep",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "electronFuses": {
      "runAsNode": true,
      "enableCookieEncryption": false,
      "enableNodeOptionsEnvironmentVariable": true,
      "enableNodeCliInspectArguments": true,
      "enableEmbeddedAsarIntegrityValidation": false,
      "onlyLoadAppFromAsar": false,
      "loadBrowserProcessSpecificV8Snapshot": false,
      "grantFileProtocolExtraPrivileges": true
    }
  }
}
