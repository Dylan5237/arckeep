{
  "version": 1,
  "actions": [
    {
      "id": "open-repo",
      "title": "打开仓库",
      "description": "从已知仓库里选一个打开。有 GitHub 名时打开仓库页面，只有本地路径时打开文件夹。",
      "type": "open-url",
      "url": "https://github.com/{{repo}}",
      "params": [
        { "key": "repo", "label": "仓库", "required": true, "input": "repo" }
      ]
    },
    {
      "id": "open-folder-editor",
      "title": "在编辑器中打开文件夹",
      "description": "编辑器只作为程序启动，参数是文件夹路径，不经过 shell。",
      "type": "open-folder",
      "editor": "code",
      "path": "{{folder}}",
      "params": [
        { "key": "folder", "label": "文件夹", "required": true, "input": "directory", "default": "C:\\work\\demo" }
      ]
    },
    {
      "id": "apo-init",
      "title": "apo 项目初始化",
      "description": "预览显示 apo init --dry-run，不会改动文件。确认后执行真正的初始化，不带 --dry-run。",
      "type": "run-command",
      "shell": "powershell",
      "cwd": "{{cwd}}",
      "previewCommand": "apo init --dry-run --name {{name}}",
      "command": "apo init --name {{name}}",
      "params": [
        { "key": "cwd", "label": "工作目录", "required": true, "input": "directory", "default": "C:\\work\\demo" },
        { "key": "name", "label": "项目名", "required": true, "default": "demo" }
      ]
    },
    {
      "id": "dispatch-note",
      "title": "派工说明",
      "description": "按参数生成一段派工说明，一键复制到剪贴板。",
      "type": "template",
      "text": "派工说明\n项目：{{project}}\n任务：{{task}}\n截止：{{due}}\n请按上面的范围处理，完成后回复结果。",
      "params": [
        { "key": "project", "label": "项目", "required": true, "default": "示例项目" },
        { "key": "task", "label": "任务", "required": true, "default": "补齐验收步骤" },
        { "key": "due", "label": "截止", "required": true, "default": "本周五" }
      ]
    }
  ]
}
